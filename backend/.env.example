# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL (matches docker-compose.yml defaults for local development)
DATABASE_URL=postgresql+psycopg://covet:covet@localhost:5432/covet

# Comma-separated retailer domains the backend is allowed to look up
ALLOWED_RETAILER_DOMAINS=abercrombie.com

# Allowed frontend origin(s) for CORS
CORS_ORIGINS=http://localhost:3000

# Twilio (not used until SMS notifications are implemented)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+15555550100
